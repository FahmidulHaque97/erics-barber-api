printf '\nChecking OpenAPI contract...\n'

if npm run openapi:check
then
  printf 'OpenAPI contract is current. Commit may proceed.\n\n'
else
  printf '\nOpenAPI contract is stale or could not be verified. Commit stopped.\n' >&2
  printf 'Run `npm run openapi:generate`, review and stage the contract, then commit again.\n\n' >&2
  exit 1
fi
